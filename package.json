{
  "name": "9nerz-desktop",
  "version": "1.1.6",
  "private": true,
  "description": "9nerz — Windows desktop client (Electron + React), ported from 9Nerz-mobile",
  "author": "9nerz",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && npm run build:electron && electron .",
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "icons": "node scripts/generate-icon.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "dayjs": "^1.11.13",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.475.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.1",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vite": "^6.0.11",
    "wait-on": "^8.0.2"
  }
}
