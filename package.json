{
  "name": "9nerz-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tauri desktop shell for 9nerz (wraps the Expo web export of ../9Nerz-mobile)",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "tauri": "tauri",
    "dev": "npm run build:web && tauri dev",
    "build": "npm run build:web && tauri build",
    "icons": "tauri icon ../9Nerz-mobile/assets/icon.png",
    "signer:generate": "tauri signer generate -w ./9nerz-updater.key"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
